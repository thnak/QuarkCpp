# Pinned, fail-closed build inputs (see SUPPLY-CHAIN.md).
#
# Bump these DELIBERATELY, in a dedicated commit, together with the workflow/install changes and
# the full CI green run. `ci/check_pins.sh` rejects an action tag/branch, a `*-latest` runner, a
# malformed/changed LLVM installer hash, a vcpkg-baseline mismatch, or an mbedTLS floor below the
# value here. The runner labels below are release-pinned; the exact runner image / apt / MSVC
# versions are captured in the CI SBOM.
LLVM_SH_SHA256=03878e08f47b66cc95bc4b544b0db3c6d9ce8d60e6cf2492ae357984330a9eae
LLVM_MAJOR=20
GCC_MAJOR=14
CLANG_MAJOR=20
VCPKG_BASELINE=6224e10f5a201e0d575d2c63dd8455786389dd2d
MBEDTLS_MIN=3.6.2
UBUNTU_RUNNER=ubuntu-24.04
UBUNTU_ARM_RUNNER=ubuntu-24.04-arm
WINDOWS_RUNNER=windows-2022
