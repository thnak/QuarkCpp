# Pinned, fail-closed build inputs (see SUPPLY-CHAIN.md).
#
# Bump these DELIBERATELY, in a dedicated commit, together with the workflow/install changes and
# the full CI green run. `ci/check_pins.sh` rejects an action tag/branch, a `*-latest` runner, a
# malformed/changed LLVM installer hash, a vcpkg-baseline mismatch, an mbedTLS floor below the
# value here, a missing/wildcard apt version, or an MSVC pin the Windows workflow does not use.
# Exact apt package versions live in ci/apt-packages.txt; the runner image label is release-pinned,
# the MSVC toolset is selected exactly in the Windows configure, and the resolved versions are
# recorded in the CI SBOM.
LLVM_SH_SHA256=03878e08f47b66cc95bc4b544b0db3c6d9ce8d60e6cf2492ae357984330a9eae
LLVM_MAJOR=22
GCC_MAJOR=14
CLANG_MAJOR=22
VCPKG_BASELINE=6224e10f5a201e0d575d2c63dd8455786389dd2d
MBEDTLS_MIN=3.6.2
# mbedTLS built from the release tarball by ci/install-mbedtls.sh (Ubuntu 24.04 ships 2.28, below MBEDTLS_MIN). The SHA-256 is of the
# upstream release asset as first observed (trust on first use); a bump changes both lines in one commit.
MBEDTLS_SRC_VERSION=3.6.5
MBEDTLS_SRC_SHA256=4a11f1777bb95bf4ad96721cac945a26e04bf19f57d905f241fe77ebeddf46d8
# libsodium floor for the opt-in pinned-key adapter (issue #40, ADR-068): 1.0.18 is what Ubuntu 24.04 (noble) ships and the
# oldest release with every primitive the adapter calls; the Windows prebuilt used locally is 1.0.22.
SODIUM_MIN=1.0.18
UBUNTU_RUNNER=ubuntu-24.04
UBUNTU_ARM_RUNNER=ubuntu-24.04-arm
WINDOWS_RUNNER=windows-2022
# Exact MSVC toolset shipped in the windows-2022 image (VS 2022 17.14); selected with
# `cmake -T version=%MSVC_VERSION%`. A runner image refresh changes this value and fails closed.
MSVC_VERSION=14.44.35211
# Keyless Sigstore signer used by the tag-triggered release workflow (pinned Action SHA too).
COSIGN_VERSION=v2.5.0
# Linux jobs run inside a digest-addressed Ubuntu base-derived image (ci/Dockerfile). The BASE
# manifest-list digest pins the OS libraries; CI_IMAGE pins the built toolchain image (built by
# .github/workflows/ci-image.yml and bumped here after the first build). The placeholder all-zero
# digest fails closed until that deliberate bump.
UBUNTU_BASE_DIGEST=68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
CI_IMAGE=ghcr.io/thnak/quark-ci@sha256:13686cb105f4d2650dd83c469945f85d2ca603a3b674c7799499098d370bcebe

# Python reference for the Noise IK differential test (#51), fetched by ci/install-noise-reference.sh: pure wheels (no pip in the image),
# each "URL SHA256". Linux x86_64, CPython 3.12. A TEST tool only; the library has no Python dependency.
NOISE_REF_WHEELS="\
https://files.pythonhosted.org/packages/9d/e1/76e4694201d67b93a6f1644b2588b4a3d965419fe189416e3496cf415db5/noiseprotocol-0.3.1-py3-none-any.whl=2e1a603a38439636cf0ffd8b3e8b12cee27d368a28b41be7dbe568b2abb23111 \
https://files.pythonhosted.org/packages/21/69/64cef1f702bf6657e0cc186ed1a2891d50d29fb41586b254e1c07adea261/cryptography-50.0.2-cp311-abi3-manylinux2014_x86_64.manylinux_2_17_x86_64.whl=630ebfea3bf689d075f82316324ff7433dc447fe6bc1bfc76524b74b4a9567d2 \
https://files.pythonhosted.org/packages/b1/db/dceb9dd5b231e1da801793f8acc9f3c52a7e1afe40bb1aae37e02b0faad5/cffi-2.1.1-cp312-cp312-manylinux2014_x86_64.manylinux_2_17_x86_64.whl=c1453022f490d2459a11819d83ad1d586e9ff65a12ac3e705ffebd46d3685dcf \
https://files.pythonhosted.org/packages/b6/ae/315bbeee126a769cbde43cf4908acb4b40408d8bf8bbf334dd7368d8dadf/pycparser-3.12-py3-none-any.whl=a076f3f489b39b43ed13563a1dafe42447445bec2e294154ec5c57fcdda4c85e"
